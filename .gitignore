UI_IDEA
# Playwright MCP scratch dir (tool artifact, not repo content)
.playwright-mcp/

# Agent worktrees (tools, not repo content)
.worktrees/

# Local Python venv (repo scripts prefer it via tools/venv-python.sh;
# system python3/python is the fallback, so Linux without .venv is unchanged)
.venv/

ui_inspiration/

/test_repo/

# Local working docs (intentionally not published)
/docs/release/release.md
/docs/notes/bugs.txt
/docs/astra/assets/image.png

# Extracted release tarball (local install/test artifact)
/Astra/

# Generated chrome bundle (rebuilt by `bun run --filter @astra/frame build:chrome`;
# the 14 static files from ui/app/public stay tracked, hashed build output does not)
/overlay/astra/chrome/app/assets/
/overlay/astra/chrome/app/browser-chrome.html

# Alpha release bundles (large, machine-local; assembled for manual upload).
# Only the build notes stay tracked.
/release/*
!/release/README-alpha.md
/.opencode
/site/*
# A tool run from the repo root (vite/vitest) drops its cache here; the real
# dependency trees live under ui/.
/node_modules
