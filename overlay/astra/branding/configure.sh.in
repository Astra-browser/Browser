# Astra branding directory (P1-T03). RENDERED by `forge overlay` from
# branding/astra.toml — do not edit the rendered copy in engine/.
# @VAR@ placeholders are filled from the single source of truth (D-19);
# OWNER_DECISION gaps fall back to dev defaults with a forge warning.

# Dev channel suffix per owner direction (release drops it, P8).
MOZ_APP_DISPLAYNAME="@ASTRA_DISPLAY_NAME@ Nightly"
MOZ_MACBUNDLE_ID=astra-nightly
# Own remoting identity: without this the build inherits firefox-default and
# a running Firefox (or another Astra install) captures our launches and
# vice versa. Must match the packaged desktop entry's StartupWMClass.
MOZ_APP_REMOTINGNAME=astra-nightly
