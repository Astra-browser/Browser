{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "resource://astra/host/schemas/boot.json",
  "title": "Host API v1 — Boot",
  "description": "Startup/shutdown handshake with version negotiation. The caller may pass min_host_api_version; the host fails fast with incompatible_host when it cannot satisfy it.",
  "type": "object",
  "properties": {
    "handshake": {
      "type": "object",
      "properties": {
        "request_id": { "type": "string" },
        "core_version": { "type": "integer", "minimum": 0 },
        "min_host_api_version": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "status": {
      "type": "object",
      "properties": {
        "request_id": { "type": "string" }
      },
      "additionalProperties": false
    },
    "launchCore": {
      "type": "object",
      "properties": {
        "request_id": { "type": "string" },
        "command": { "type": "string" }
      },
      "additionalProperties": false
    },
    "shutdown": {
      "type": "object",
      "properties": {
        "request_id": { "type": "string" },
        "reason": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
