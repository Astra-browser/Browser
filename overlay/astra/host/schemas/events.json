{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "resource://astra/host/schemas/events.json",
  "title": "Host API v1 — events (P1-T10; envelope per plan §5.4 / Appendix C)",
  "description": "Every event is { event_seq, type, data }. event_seq is monotonic per session so the core can detect gaps and resync.",
  "type": "object",
  "properties": {
    "event_seq": { "type": "integer", "minimum": 1 },
    "type": {
      "type": "string",
      "enum": [
        "boot.ready",
        "tab.created",
        "tab.updated",
        "tab.closed",
        "nav.committed",
        "pane.shown",
        "pane.hidden"
      ]
    },
    "data": { "type": "object" }
  },
  "required": ["event_seq", "type", "data"],
  "additionalProperties": false
}
