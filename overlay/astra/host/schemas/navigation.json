{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "resource://astra/host/schemas/navigation.json",
  "title": "Host API v1 — Navigation",
  "type": "object",
  "properties": {
    "loadURL": {
      "type": "object",
      "properties": {
        "request_id": { "type": "string" },
        "astra_tab_id": { "type": "string" },
        "url": { "type": "string" }
      },
      "required": ["url"],
      "additionalProperties": false
    },
    "goBack": {
      "type": "object",
      "properties": {
        "request_id": { "type": "string" },
        "astra_tab_id": { "type": "string" }
      },
      "additionalProperties": false
    },
    "goForward": {
      "type": "object",
      "properties": {
        "request_id": { "type": "string" },
        "astra_tab_id": { "type": "string" }
      },
      "additionalProperties": false
    },
    "reload": {
      "type": "object",
      "properties": {
        "request_id": { "type": "string" },
        "astra_tab_id": { "type": "string" }
      },
      "additionalProperties": false
    },
    "hardReload": {
      "type": "object",
      "properties": {
        "request_id": { "type": "string" },
        "astra_tab_id": { "type": "string" }
      },
      "additionalProperties": false
    },
    "stop": {
      "type": "object",
      "properties": {
        "request_id": { "type": "string" },
        "astra_tab_id": { "type": "string" }
      },
      "additionalProperties": false
    },
    "setZoom": {
      "type": "object",
      "properties": {
        "request_id": { "type": "string" },
        "astra_tab_id": { "type": "string" },
        "zoom": { "type": "number" }
      },
      "required": ["zoom"],
      "additionalProperties": false
    },
    "getZoom": {
      "type": "object",
      "properties": {
        "request_id": { "type": "string" },
        "astra_tab_id": { "type": "string" }
      },
      "additionalProperties": false
    },
    "findInPage": {
      "type": "object",
      "properties": {
        "request_id": { "type": "string" },
        "astra_tab_id": { "type": "string" },
        "query": { "type": "string" },
        "direction": { "type": "string", "enum": ["forward", "backward"] }
      },
      "required": ["query"],
      "additionalProperties": false
    },
    "setFindResult": {
      "type": "object",
      "properties": {
        "request_id": { "type": "string" },
        "astra_tab_id": { "type": "string" },
        "matchCount": { "type": "integer", "minimum": 0 },
        "activeMatch": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "print": {
      "type": "object",
      "properties": {
        "request_id": { "type": "string" },
        "astra_tab_id": { "type": "string" }
      },
      "additionalProperties": false
    },
    "setReaderMode": {
      "type": "object",
      "properties": {
        "request_id": { "type": "string" },
        "astra_tab_id": { "type": "string" },
        "enabled": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "setReaderAvailable": {
      "type": "object",
      "properties": {
        "request_id": { "type": "string" },
        "astra_tab_id": { "type": "string" },
        "available": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
