{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "resource://astra/host/schemas/panes.json",
  "title": "Host API v1 — Panes",
  "type": "object",
  "properties": {
    "show": {
      "type": "object",
      "properties": {
        "request_id": { "type": "string" },
        "pane_id": { "type": "string" }
      },
      "required": ["pane_id"],
      "additionalProperties": false
    },
    "hide": {
      "type": "object",
      "properties": {
        "request_id": { "type": "string" },
        "pane_id": { "type": "string" }
      },
      "required": ["pane_id"],
      "additionalProperties": false
    },
    "list": {
      "type": "object",
      "properties": {
        "request_id": { "type": "string" }
      },
      "additionalProperties": false
    },
    "attach": {
      "type": "object",
      "properties": {
        "request_id": { "type": "string" },
        "pane_id": { "type": "string" },
        "slot": { "type": "string" },
        "astra_tab_id": { "type": ["string", "null"] }
      },
      "required": ["pane_id", "slot"],
      "additionalProperties": false
    },
    "detach": {
      "type": "object",
      "properties": {
        "request_id": { "type": "string" },
        "pane_id": { "type": "string" }
      },
      "required": ["pane_id"],
      "additionalProperties": false
    },
    "setRect": {
      "type": "object",
      "properties": {
        "request_id": { "type": "string" },
        "pane_id": { "type": "string" },
        "rect": {
          "type": "object",
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" },
            "width": { "type": "number", "minimum": 0 },
            "height": { "type": "number", "minimum": 0 }
          },
          "required": ["x", "y", "width", "height"],
          "additionalProperties": false
        }
      },
      "required": ["pane_id", "rect"],
      "additionalProperties": false
    },
    "check": {
      "type": "object",
      "properties": {
        "request_id": { "type": "string" },
        "pane_id": { "type": "string" },
        "generation": { "type": "integer", "minimum": 0 }
      },
      "required": ["pane_id", "generation"],
      "additionalProperties": false
    },
    "get": {
      "type": "object",
      "properties": {
        "request_id": { "type": "string" },
        "pane_id": { "type": "string" }
      },
      "required": ["pane_id"],
      "additionalProperties": false
    },
    "Pane": {
      "type": "object",
      "properties": {
        "pane_id": { "type": "string" },
        "visible": { "type": "boolean" },
        "slot": { "type": ["string", "null"] },
        "rect": {
          "type": ["object", "null"],
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" },
            "width": { "type": "number" },
            "height": { "type": "number" }
          },
          "required": ["x", "y", "width", "height"],
          "additionalProperties": false
        },
        "astra_tab_id": { "type": ["string", "null"] },
        "generation": { "type": "integer", "minimum": 0 }
      },
      "required": ["pane_id", "visible", "generation"],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
