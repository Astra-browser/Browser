{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "resource://astra/host/schemas/permissions.json",
  "title": "Host API — page permission prompt (P6b)",
  "description": "Payload of `page-permission-prompt-changed`. The app shows at most one exact request; every identity is an opaque stale fence it may only echo back with `page_permission_respond`.",
  "type": "object",
  "properties": {
    "projection_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "prompt": {
      "type": ["object", "null"],
      "properties": {
        "profile_id": { "type": "string", "minLength": 1 },
        "item_id": { "type": "string", "minLength": 1 },
        "request_id": { "type": "string", "minLength": 1 },
        "origin": { "type": "string", "minLength": 1 },
        "kinds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "camera",
              "microphone",
              "geolocation",
              "notifications",
              "persistent-storage",
              "xr",
              "loopback-network",
              "local-network"
            ]
          }
        },
        "rememberable": { "type": "boolean" },
        "processing": { "type": "boolean" },
        "in_sidebar": { "type": "boolean" },
        "blocked_by_system": { "type": "boolean" }
      },
      "required": [
        "profile_id",
        "item_id",
        "request_id",
        "origin",
        "kinds",
        "rememberable",
        "processing",
        "in_sidebar",
        "blocked_by_system"
      ],
      "additionalProperties": false
    }
  },
  "required": ["projection_revision", "prompt"],
  "additionalProperties": false
}
