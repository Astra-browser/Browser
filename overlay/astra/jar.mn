  content/astra/res/host/Dialogs.sys.mjs (host/Dialogs.sys.mjs)
  content/astra/res/host/Helpers.sys.mjs (host/Helpers.sys.mjs)
  content/astra/res/host/Sidebar.sys.mjs (host/Sidebar.sys.mjs)
  content/astra/res/host/WebExtensions.sys.mjs (host/WebExtensions.sys.mjs)
  content/astra/res/host/Settings.sys.mjs (host/Settings.sys.mjs)
  content/astra/res/host/Accounts.sys.mjs (host/Accounts.sys.mjs)
  content/astra/res/host/schemas/tabs.json (host/schemas/tabs.json)
  content/astra/res/host/schemas/navigation.json (host/schemas/navigation.json)
  content/astra/res/host/schemas/panes.json (host/schemas/panes.json)
  content/astra/res/host/schemas/events.json (host/schemas/events.json)
  content/astra/res/host/schemas/boot.json (host/schemas/boot.json)
  content/astra/res/host/ContentTools.sys.mjs (host/ContentTools.sys.mjs)
  content/astra/res/host/schemas/windows.json (host/schemas/windows.json)
  content/astra/res/host/schemas/session.json (host/schemas/session.json)
  content/astra/res/host/schemas/history.json (host/schemas/history.json)
  content/astra/res/host/schemas/containers.json (host/schemas/containers.json)
  content/astra/res/host/schemas/dialogs.json (host/schemas/dialogs.json)
