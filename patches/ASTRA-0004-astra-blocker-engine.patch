+}
+
+NS_IMETHODIMP
+AstraBlockerService::ClassifyBounce(const nsACString& aUrl,
+                                    nsACString& aResult) {
+  return AstraBlocker::ClassifyBounceJson(aUrl, aResult);
+}
+
+NS_IMETHODIMP
+AstraBlockerService::Cname(const nsACString& aHost, nsACString& aResult) {
+  return AstraBlocker::CnameJson(aHost, aResult);
+}
+
+NS_IMETHODIMP
+AstraBlockerService::CheckUrl(const nsACString& aUrl,
+                              const nsACString& aSourceUrl,
+                              const nsACString& aType,
+                              nsACString& aResult) {
+  return AstraBlocker::CheckUrlJson(aUrl, aSourceUrl, aType, aResult);
+}
+
+NS_IMETHODIMP
+AstraBlockerService::CosmeticFor(const nsACString& aUrl,
+                                 const nsACString& aClassesJson,
+                                 const nsACString& aIdsJson,
+                                 nsACString& aResult) {
+  return AstraBlocker::CosmeticFor(aUrl, aClassesJson, aIdsJson, aResult);
+}
+
+NS_IMETHODIMP
+AstraBlockerService::Stats(nsACString& aResult) {
+  return AstraBlocker::StatsJson(aResult);
+}
+
+NS_IMETHODIMP
+AstraBlockerService::ResetStats() {
+  AstraBlocker::ResetStats();
+  return NS_OK;
+}
+
+already_AddRefed<nsIAstraBlockerService> AstraBlockerServiceConstructor() {
+  RefPtr<AstraBlockerService> service = new AstraBlockerService();
+  return service.forget().downcast<nsIAstraBlockerService>();
+}
+
+}  // namespace mozilla
