diff --git a/toolkit/components/astra_blocker_engine/src/lib.rs b/toolkit/components/astra_blocker_engine/src/lib.rs
new file mode 100644
index 0000000000..8a3cce84de
--- /dev/null
+++ b/toolkit/components/astra_blocker_engine/src/lib.rs
@@ -0,0 +1,377 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+//! `astra_blocker_engine`: in-tree Gecko network-hook engine for the Astra
+//! ad/tracker blocker (P4-T02).
+//!
+//! This crate mirrors `content_classifier_engine` (same adblock-rust
+//! dependency, same cbindgen FFI shape) but serves Astra verdicts instead of
+//! tracking-protection classification:
+//!   * first- AND third-party loads are classified (no third-party-only
+//!     exemption — a full adblocker must catch same-host ad delivery);
+//!   * rules come from the Astra EasyList/EasyPrivacy seed installed via the
+//!     Host API `Net` module (P4-T01 `astra-blocker` owns the seed bytes and
+//!     list-update mechanism; this crate only holds the compiled engine);
+//!   * global on/off plus per-site (per-host) toggles mirror the
+//!     `astra-blocker` semantics so the sidecar and the hook agree.
+//!
+//! Ownership model (mirrors `content_classifier_engine` deliberately):
+//! engine instances are Box-leaked and owned by the C++ hook — there is
+//! deliberately NO `Engine` in a Rust static. A static `Mutex<Option<Engine>>`
+//! would require `Engine: Sync`, but the unified gkrust feature set includes
+//! the content classifier's `single-thread` feature, under which `Engine`
+//! holds `Rc` state and is not `Sync`. Box ownership needs no such bound,
+//! and requesting exactly the classifier's feature set
+//! (`full-regex-handling` + `single-thread`, no `embedded-domain-resolver`)
+//! keeps the unified build identical to stock, so upstream code is unaffected.
+//!
+//! Version note: adblock is pinned to `=0.12.1`, the revision vendored in
+//! `third_party/rust` and audited in `supply-chain/audits.toml`. The sidecar
+//! crate (`astra-blocker`) uses 0.13.5; both expose identical verdict
+//! behaviour on the shared fixture corpus (see `tools/blocker-wiring-check.sh`).
+//! In 0.12.1 `Request::new` takes 3 arguments (no http-method parameter yet)
+//! and `BlockerResult` has no `should_block()` helper — the verdict here is
+//! `matched && exception.is_none()`.
+
+use std::collections::HashSet;
+use std::os::raw::c_char;
+use std::sync::{Mutex, OnceLock};
+
+use adblock::lists::ParseOptions;
+use adblock::request::Request;
+use adblock::Engine;
+use cstr::cstr;
+use nserror::{nsresult, NS_ERROR_INVALID_ARG, NS_ERROR_SERVICE_NOT_AVAILABLE, NS_OK};
+use nsstring::nsCString;
+use xpcom::interfaces::nsIEffectiveTLDService;
+
+/// Compiled network rules for one installed rule set. Owned by the C++
+/// hook via `Box::into_raw` (see `AstraBlocker.cpp`); never in a Rust
+/// static, so no `Sync` bound on `Engine` is required.
+pub struct AstraBlockerEngine {
+    engine: Engine,
+}
+
+static ETLD_SERVICE: Mutex<Option<xpcom::RefPtr<nsIEffectiveTLDService>>> = Mutex::new(None);
+
+/// Lower-cased hosts (no trailing dot) where protection is paused.
+/// `HashSet<String>` is `Sync`, so this static is feature-independent.
+static DISABLED_HOSTS: OnceLock<Mutex<HashSet<String>>> = OnceLock::new();
+
+fn hosts_slot() -> &'static Mutex<HashSet<String>> {
+    DISABLED_HOSTS.get_or_init(|| Mutex::new(HashSet::new()))
+}
+
+/// Lower-cases and trims a host for toggle comparisons.
+fn normalize_host(host: &str) -> String {
+    host.trim().trim_end_matches('.').to_lowercase()
+}
+
+/// Extracts the host from a URL for per-site checks. Returns `""` when the
+/// URL has no parseable host (mirrors `astra-blocker::host_of_url`).
+fn host_of_url(url: &str) -> String {
+    let after_scheme = url.split("://").nth(1).unwrap_or(url);
+    let authority = after_scheme
+        .split('/')
+        .next()
+        .unwrap_or("")
+        .split('@')
+        .next_back()
+        .unwrap_or("");
+    let host = authority.split(':').next().unwrap_or("");
+    normalize_host(host)
+}
+
+/// Copies `(ptr, len)` into an owned `String` (lossy). A null input pointer
+/// reads as empty; a null `out` pointer is handled by callers.
+fn read_str(ptr: *const c_char, len: usize) -> String {
+    if ptr.is_null() || len == 0 {
+        return String::new();
+    }
+    let bytes = unsafe { std::slice::from_raw_parts(ptr as *const u8, len) };
+    String::from_utf8_lossy(bytes).into_owned()
+}
+
+struct SchemelessSiteResolver {}
+
+impl adblock::url_parser::ResolvesDomain for SchemelessSiteResolver {
+    fn get_host_domain(&self, host: &str) -> (usize, usize) {
+        let guard = match ETLD_SERVICE.lock() {
+            Ok(g) => g,
+            Err(_) => return (0, host.len()),
+        };
+        let etld_service = match guard.as_ref() {
+            Some(s) => s,
+            None => return (0, host.len()),
+        };
+
+        let mut host_cstring = nsCString::new();
+        host_cstring.assign(host);
+
+        let mut base_domain = nsCString::new();
+
+        unsafe {
+            if etld_service
+                .GetBaseDomainFromHost(&*host_cstring, 0, &mut *base_domain)
+                .succeeded()
+            {
+                let base_domain_len = base_domain.len();
+                if base_domain_len > 0 && base_domain_len <= host.len() {
+                    return (host.len() - base_domain_len, host.len());
+                }
+            }
+        }
+
+        (0, host.len())
+    }
+}
+
+/// Points adblock's global domain resolver at the eTLD service. Idempotent:
+/// a previously installed resolver is kept (`set` fails) rather than
+/// replaced. Called from `engine_from_rules` so no separate init ordering
+/// is required (unlike the classifier's explicit init entry point).
+fn ensure_domain_resolver() {
+    let etld_service = match xpcom::get_service::<nsIEffectiveTLDService>(cstr!(
+        "@mozilla.org/network/effective-tld-service;1"
+    )) {
+        Some(s) => s,
+        None => return,
+    };
+    if let Ok(mut guard) = ETLD_SERVICE.lock() {
+        guard.replace(etld_service);
+    }
+    let resolver = Box::new(SchemelessSiteResolver {});
+    let _ = adblock::url_parser::set_domain_resolver(resolver);
+}
+
+/// Installs `rules` (newline-separated filter-list text), handing ownership
+/// of a new engine instance to the caller (`Box::into_raw`). The caller
+/// replaces any previous instance (destroying it first). Fail-open boot is
+/// preserved: with no instance installed, every verdict allows.
+#[no_mangle]
+pub unsafe extern "C" fn astra_blocker_engine_from_rules(
+    rules: *const c_char,
+    rules_len: usize,
+    out_engine: *mut *mut AstraBlockerEngine,
+) -> nsresult {
+    if out_engine.is_null() {
+        return NS_ERROR_INVALID_ARG;
+    }
+    ensure_domain_resolver();
+    let text = read_str(rules, rules_len);
+    let engine = Engine::from_rules(text.lines().map(str::to_owned), ParseOptions::default());
+    let boxed = Box::new(AstraBlockerEngine { engine });
+    *out_engine = Box::into_raw(boxed);
+    NS_OK
+}
+
+/// Destroys an instance created by `astra_blocker_engine_from_rules`.
+#[no_mangle]
+pub unsafe extern "C" fn astra_blocker_engine_destroy(engine: *mut AstraBlockerEngine) {
+    if !engine.is_null() {
+        drop(Box::from_raw(engine));
+    }
+}
+
+/// Pauses (`false`) or resumes (`true`) protection for one site (host).
+#[no_mangle]
+pub extern "C" fn astra_blocker_set_site_enabled(
+    host: *const c_char,
+    host_len: usize,
+    enabled: bool,
+) -> nsresult {
+    let key = normalize_host(&read_str(host, host_len));
+    match hosts_slot().lock() {
+        Ok(mut hosts) => {
+            if enabled {
+                hosts.remove(&key);
+            } else if !key.is_empty() {
+                hosts.insert(key);
+            }
+            NS_OK
+        }
+        Err(_) => NS_ERROR_INVALID_ARG,
+    }
+}
+
+/// Reports whether `engine` looks usable (non-null instance). The C++ hook
+/// combines this with the `astra.blocker.enabled` pref.
+#[no_mangle]
+pub unsafe extern "C" fn astra_blocker_engine_is_installed(
+    engine: *const AstraBlockerEngine,
+) -> bool {
+    !engine.is_null()
+}
+
+/// Verdict for one request against one installed instance. Fail-open: allow
+/// when protection is paused for the source host or the request cannot be
+/// parsed (mirrors `astra-blocker::Blocker::check`).
+fn should_block(engine: &Engine, url: &str, source_url: &str, request_type: &str) -> bool {
+    let disabled = match hosts_slot().lock() {
+        Ok(hosts) => hosts.contains(&host_of_url(source_url)),
+        Err(_) => return false,
+    };
+    if disabled {
+        return false;
+    }
+    let Ok(request) = Request::new(url, source_url, request_type) else {
+        return false;
+    };
+    // adblock 0.12.1 has no should_block() helper: matched with no
+    // exception means block (same rule the content classifier applies).
+    let result = engine.check_network_request(&request);
+    result.matched && result.exception.is_none()
+}
+
+/// FFI verdict entry point for `AstraBlocker::ShouldBlockChannel`.
+#[no_mangle]
+pub unsafe extern "C" fn astra_blocker_engine_should_block(
+    engine: *const AstraBlockerEngine,
+    url: *const c_char,
+    url_len: usize,
+    source_url: *const c_char,
+    source_url_len: usize,
+    request_type: *const c_char,
+    request_type_len: usize,
+    out_block: *mut bool,
+) -> nsresult {
+    if engine.is_null() || out_block.is_null() {
+        return NS_ERROR_INVALID_ARG;
+    }
+    let block = should_block(
+        &(*engine).engine,
+        &read_str(url, url_len),
+        &read_str(source_url, source_url_len),
+        &read_str(request_type, request_type_len),
+    );
+    *out_block = block;
+    NS_OK
+}
+
+/// Test-only resolver that treats every host as its own registrable domain.
+/// The eTLD service is unavailable outside the browser; without any
+/// resolver installed, third-party classification may panic.
+#[cfg(test)]
+fn install_test_resolver() {
+    struct TestResolver;
+    impl adblock::url_parser::ResolvesDomain for TestResolver {
+        fn get_host_domain(&self, host: &str) -> (usize, usize) {
+            (0, host.len())
+        }
+    }
+    static INSTALLED: std::sync::OnceLock<()> = std::sync::OnceLock::new();
+    INSTALLED.get_or_init(|| {
+        let _ = adblock::url_parser::set_domain_resolver(Box::new(TestResolver));
+    });
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// Same-shape fixture list as the `astra-blocker` (P4-T01) corpus:
+    /// basic blocks, exceptions, `$important` overrides. The shared
+    /// `tools/blocker-wiring-check.sh` parity run keeps both engines honest.
+    const FIXTURE_RULES: &str = "\
+||ads.fixture.invalid^\n\
+@@||allow.fixture.invalid^\n\
+||stern.fixture.invalid^\n\
+@@||stern.fixture.invalid^\n\
+||stern.fixture.invalid^$important\n";
+
+    fn engine_from_fixtures() -> Engine {
+        Engine::from_rules(
+            FIXTURE_RULES.lines().map(str::to_owned),
+            ParseOptions::default(),
+        )
+    }
+
+    fn check_with(engine: &Engine, url: &str, source: &str, kind: &str) -> bool {
+        install_test_resolver();
+        let Ok(request) = Request::new(url, source, kind) else {
+            return false;
+        };
+        let result = engine.check_network_request(&request);
+        result.matched && result.exception.is_none()
+    }
+
+    #[test]
+    fn fixture_verdict_parity() {
+        let engine = engine_from_fixtures();
+        // Basic block vs unlisted allow.
+        assert!(check_with(
+            &engine,
+            "https://ads.fixture.invalid/pixel.gif",
+            "https://shop.fixture.invalid/",
+            "image"
+        ));
+        assert!(!check_with(
+            &engine,
+            "https://cdn.fixture.invalid/app.js",
+            "https://shop.fixture.invalid/",
+            "script"
+        ));
+        // Exception allow-lists the match.
+        assert!(!check_with(
+            &engine,
+            "https://allow.fixture.invalid/a.js",
+            "https://shop.fixture.invalid/",
+            "script"
+        ));
+        // `$important` overrides the exception.
+        assert!(check_with(
+            &engine,
+            "https://stern.fixture.invalid/x.js",
+            "https://shop.fixture.invalid/",
+            "script"
+        ));
+    }
+
+    #[test]
+    fn host_helpers_match_sidecar_semantics() {
+        assert_eq!(
+            host_of_url("https://shop.fixture.invalid:443/a?b=c"),
+            "shop.fixture.invalid"
+        );
+        assert_eq!(
+            host_of_url("https://user@ads.fixture.invalid/x"),
+            "ads.fixture.invalid"
+        );
+        assert_eq!(host_of_url("SHOP.FIXTURE.INVALID."), "shop.fixture.invalid");
+        assert_eq!(host_of_url(":::"), "");
+        assert_eq!(normalize_host("  Example.COM. "), "example.com");
+    }
+
+    #[test]
+    fn ffi_round_trip_install_check_destroy() {
+        install_test_resolver();
+        let mut ptr: *mut AstraBlockerEngine = std::ptr::null_mut();
+        let rules = FIXTURE_RULES.as_bytes();
+        let rv = unsafe {
+            astra_blocker_engine_from_rules(rules.as_ptr() as *const c_char, rules.len(), &mut ptr)
+        };
+        assert_eq!(rv, NS_OK);
+        assert!(!ptr.is_null());
+        assert!(unsafe { astra_blocker_engine_is_installed(ptr) });
+        let url = b"https://ads.fixture.invalid/pixel.gif";
+        let src = b"https://shop.fixture.invalid/";
+        let kind = b"image";
+        let mut block = false;
+        let rv = unsafe {
+            astra_blocker_engine_should_block(
+                ptr,
+                url.as_ptr() as *const c_char,
+                url.len(),
+                src.as_ptr() as *const c_char,
+                src.len(),
+                kind.as_ptr() as *const c_char,
+                kind.len(),
+                &mut block,
+            )
+        };
+        assert_eq!(rv, NS_OK);
+        assert!(block);
+        unsafe { astra_blocker_engine_destroy(ptr) };
+    }
+}
