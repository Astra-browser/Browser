+[package]
+name = "astra_blocker_engine"
+version = "0.1.0"
+edition = "2021"
+license = "MPL-2.0"
+description = "Astra in-tree network-hook engine: adblock-rust verdicts for the Gecko network layer (P4-T02)"
+
+[dependencies]
+# Pinned to the exact adblock revision already vendored in third_party/rust
+# and covered by the safe-to-deploy audit in supply-chain/audits.toml, so
+# `mach vendor rust` is a no-op and no new `cargo vet` entries are needed.
+# NOTE: default-features MUST stay off and "single-thread" MUST stay out:
+# the default feature set disables Send+Sync on Engine, which would break the
+# static Mutex below (the verdict runs on the classifier worker thread).
