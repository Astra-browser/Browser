diff --git a/toolkit/components/astra_blocker_engine/AstraBlocker.cpp b/toolkit/components/astra_blocker_engine/AstraBlocker.cpp
new file mode 100644
index 0000000000..ce44c5e98b
--- /dev/null
+++ b/toolkit/components/astra_blocker_engine/AstraBlocker.cpp
@@ -0,0 +1,138 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#include "mozilla/AstraBlocker.h"
+
+#include "astra_blocker_ffi.h"
+
+#include "mozilla/Preferences.h"
+#include "nsCOMPtr.h"
+#include "nsIChannel.h"
+#include "nsIContentPolicy.h"
+#include "nsILoadInfo.h"
+#include "nsIPrincipal.h"
+#include "nsIURI.h"
+
+namespace mozilla {
+namespace AstraBlocker {
+
+// Must match the pref registered by the Astra overlay (default false: no
+// rules installed at first boot means no blocks until the Host API Net
+// module pushes the seed — fail-closed arming, fail-open verdicts).
+static const char* kEnabledPref = "astra.blocker.enabled";
+
+// Maps Gecko content-policy types to adblock-rust request types. Mirrors the
+// mapping in ContentClassifierEngine.cpp so both engines classify resources
+// the same way.
+static void RequestTypeForPolicy(ExtContentPolicyType aType, nsACString& aOut) {
+  switch (aType) {
+    case ExtContentPolicyType::TYPE_CSP_REPORT:
+      aOut.AssignLiteral("csp_report");
+      break;
+    case ExtContentPolicyType::TYPE_DOCUMENT:
+      aOut.AssignLiteral("document");
+      break;
+    case ExtContentPolicyType::TYPE_FONT:
+      aOut.AssignLiteral("font");
+      break;
+    case ExtContentPolicyType::TYPE_IMAGE:
+    case ExtContentPolicyType::TYPE_IMAGESET:
+      aOut.AssignLiteral("image");
+      break;
+    case ExtContentPolicyType::TYPE_MEDIA:
+      aOut.AssignLiteral("media");
+      break;
+    case ExtContentPolicyType::TYPE_OBJECT:
+      aOut.AssignLiteral("object");
+      break;
+    case ExtContentPolicyType::TYPE_BEACON:
+    case ExtContentPolicyType::TYPE_PING:
+      aOut.AssignLiteral("ping");
+      break;
+    case ExtContentPolicyType::TYPE_SCRIPT:
+      aOut.AssignLiteral("script");
+      break;
+    case ExtContentPolicyType::TYPE_STYLESHEET:
+      aOut.AssignLiteral("stylesheet");
+      break;
+    case ExtContentPolicyType::TYPE_SUBDOCUMENT:
+      aOut.AssignLiteral("subdocument");
+      break;
+    case ExtContentPolicyType::TYPE_WEBSOCKET:
+      aOut.AssignLiteral("websocket");
+      break;
+    case ExtContentPolicyType::TYPE_XMLHTTPREQUEST:
+      aOut.AssignLiteral("xmlhttprequest");
+      break;
+    default:
+      aOut.AssignLiteral("other");
+      break;
+  }
+}
+
+bool IsInitialized() {
+  // Rules arrive from the Host API Net module after boot; before that every
+  // verdict fails open. Probing the Rust side keeps C++ and Rust consistent
+  // by construction (no mirrored state to drift).
+  return astra_blocker_is_installed();
+}
+
+bool IsEnabled() {
+  // Cheap pref gate first so disabled builds skip the FFI round-trip.
+  return Preferences::GetBool(kEnabledPref, false) && IsInitialized();
+}
+
+bool ShouldBlockChannel(nsIChannel* aChannel) {
+  if (!IsEnabled() || !aChannel) {
+    return false;
+  }
+
+  nsCOMPtr<nsIURI> uri;
+  if (NS_FAILED(aChannel->GetURI(getter_AddRefs(uri))) || !uri) {
+    return false;
+  }
+  nsCString url;
+  if (NS_FAILED(uri->GetAsciiSpec(url))) {
+    return false;
+  }
+
+  // System/chrome loads have no content principal: never block browser
+  // internals, updater pings, or extension machinery on Astra rules.
+  nsCOMPtr<nsILoadInfo> loadInfo;
+  if (NS_FAILED(aChannel->GetLoadInfo(getter_AddRefs(loadInfo))) || !loadInfo) {
+    return false;
+  }
+  nsCOMPtr<nsIPrincipal> loadingPrincipal = loadInfo->GetLoadingPrincipal();
+  if (!loadingPrincipal || loadingPrincipal->IsSystemPrincipal()) {
+    return false;
+  }
+  nsCString sourceSpec;
+  if (NS_FAILED(loadingPrincipal->GetAsciiSpec(sourceSpec))) {
+    return false;
+  }
+
+  nsCString requestType;
+  RequestTypeForPolicy(loadInfo->GetExternalContentPolicyType(), requestType);
+
+  bool block = false;
+  nsresult rv = astra_blocker_should_block(
+      url.get(), url.Length(), sourceSpec.get(), sourceSpec.Length(),
+      requestType.get(), requestType.Length(), &block);
+  return NS_SUCCEEDED(rv) && block;
+}
+
+nsresult InstallRules(const nsACString& aRules) {
+  return astra_blocker_install_rules(aRules.BeginReading(), aRules.Length());
+}
+
+void SetEnabled(bool aEnabled) {
+  Preferences::SetBool(kEnabledPref, aEnabled);
+}
+
+void SetSiteEnabled(const nsACString& aHost, bool aEnabled) {
+  astra_blocker_set_site_enabled(aHost.BeginReading(), aHost.Length(), aEnabled);
+}
+
+}  // namespace AstraBlocker
+}  // namespace mozilla
