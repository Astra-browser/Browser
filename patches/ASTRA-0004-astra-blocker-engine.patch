+
+# Astra blocker engine (source of truth: blocker/engine/).
+# The Rust crate is linked into libxul via gkrust (ASTRA-0003); this file
+# builds the C++ network bridge and the XPCOM management service, compiles
+# the IDL the service exposes to chrome JS, and generates the FFI header.
+
+XPIDL_MODULE = "astra_blocker"
+
+XPIDL_SOURCES += [
+    "nsIAstraBlockerService.idl",
+]
+
+XPCOM_MANIFESTS += [
+    "components.conf",
+]
+
