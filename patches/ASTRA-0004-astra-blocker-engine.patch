+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#ifndef mozilla_AstraBlocker_h
+#define mozilla_AstraBlocker_h
+
+#include "nsError.h"
+#include "nsString.h"
+
+class nsIChannel;
+
+namespace mozilla {
+
+// In-tree verdict interface for the Astra ad/tracker blocker (P4-T02).
+// Implemented in AstraBlocker.cpp; verdicts come from the
+// astra_blocker_engine Rust crate (adblock-rust) via astra_blocker_ffi.h.
+namespace AstraBlocker {
+
+// True once compiled rules have been installed (via InstallRules).
+bool IsInitialized();
+
+// True when blocking is armed: the astra.blocker.enabled pref is on AND
+// rules are installed. Cheap; safe to call per channel.
+bool IsEnabled();
+
+// Verdict for one channel: global switch, per-site toggle, then the
+// adblock-rust network match. Fail-open on any error. First- and
+// third-party loads are both classified (unlike the content classifier,
+// which exempts first-party loads for webcompat).
+bool ShouldBlockChannel(nsIChannel* aChannel);
+
+// Management entry points. Rules and toggles originate in astra-core and
+// cross the Host API Net module; the JS bridge calls these (directly or via
+// a future nsIAstraBlockerService XPCOM wrapper).
+nsresult InstallRules(const nsACString& aRules);
+void SetEnabled(bool aEnabled);
+void SetSiteEnabled(const nsACString& aHost, bool aEnabled);
+
+}  // namespace AstraBlocker
+}  // namespace mozilla
+
+#endif  // mozilla_AstraBlocker_h
