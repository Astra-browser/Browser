-      watcherInfo.watcher.conn.cancelForwarding(forwardingPrefix);
+      if (watcherInfo.watcher.conn) {
+        watcherInfo.watcher.conn.cancelForwarding(forwardingPrefix);
+      }
     }
 
     if (!this.#watchers.size) {
