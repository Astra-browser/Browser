new file mode 100644
index 0000000000..513969c49d
--- /dev/null
+++ b/dom/webauthn/nsIAstraPasskeys.idl
@@ -0,0 +1,32 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#include "nsISupports.idl"
+
+/**
+ * Astra platform-passkey vault management.
+ *
+ * The same encrypted vault the in-tree WebAuthn platform token reads. Settings
+ * uses this to create the vault, change the PIN, list/remove credentials and
+ * toggle the OS verification path. WebAuthn itself never goes through this
+ * interface: the token talks to the Rust vault directly.
+ *
+ * `statusJson` and `listJson` are small JSON objects (the vault's own shapes);
+ * PINs and private keys never appear in either.
+ */
+[scriptable, uuid(56085a44-c3d1-4f39-a9f6-b7c69d7a5ac6)]
+interface nsIAstraPasskeys : nsISupports {
+  readonly attribute ACString statusJson;
+
+  void create(in ACString pin, in boolean systemUnlock);
+  void unlock(in ACString pin);
+  void lock();
+  void changePin(in ACString oldPin, in ACString newPin);
+  void setSystemUnlock(in boolean enabled);
+
+  ACString listJson();
+  boolean removeCredential(in ACString credentialIdBase64);
+  void removeAllCredentials();
+  void destroy();
+};
