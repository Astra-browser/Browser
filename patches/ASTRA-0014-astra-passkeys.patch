diff --git a/dom/webauthn/authrs_bridge/src/nss_seal.rs b/dom/webauthn/authrs_bridge/src/nss_seal.rs
new file mode 100644
index 0000000000..69f4341d37
--- /dev/null
+++ b/dom/webauthn/authrs_bridge/src/nss_seal.rs
@@ -0,0 +1,159 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+//! NSS implementation of the `astra_passkeys::Seal` backend.
+//!
+//! The wrappers mirror `authenticator/src/crypto/nss.rs`: AES-256-CBC,
+//! HMAC-SHA256 and PK11 random bytes, all from the NSS PKCS#11 module the
+//! browser already initialised.
+
+use astra_passkeys::{Seal, VaultError};
+use nss_rs::p11::{
+    PK11Origin, PK11_CreateContextBySymKey, PK11_Decrypt, PK11_DigestFinal, PK11_DigestOp,
+    PK11_Encrypt, PK11_GenerateRandom, PK11_ImportSymKey, Slot,
+};
+use nss_rs::{IntoResult, SECItem, SECItemBorrowed};
+use pkcs11_bindings::{CKA_ENCRYPT, CKA_SIGN, CKM_AES_CBC, CKM_SHA256_HMAC};
+use std::os::raw::{c_int, c_uint};
+use std::ptr;
+
+const KEY_LEN: usize = 32;
+const IV_LEN: usize = 16;
+const SHA256_LENGTH: usize = 32;
+
+pub struct NssSeal;
+
+impl Seal for NssSeal {
+    fn random(&self, len: usize) -> Result<Vec<u8>, VaultError> {
+        nss_rs::init().map_err(|_| VaultError::Crypto)?;
+        let count = c_int::try_from(len).map_err(|_| VaultError::Crypto)?;
+        let mut out = vec![0u8; len];
+        unsafe { PK11_GenerateRandom(out.as_mut_ptr(), count) }
+            .into_result()
+            .map_err(|_| VaultError::Crypto)?;
+        Ok(out)
+    }
+
+    fn hmac_sha256(&self, key: &[u8], data: &[u8]) -> Result<Vec<u8>, VaultError> {
+        nss_rs::init().map_err(|_| VaultError::Crypto)?;
+        let len = u32::try_from(data.len()).map_err(|_| VaultError::Crypto)?;
+        let slot = Slot::internal().map_err(|_| VaultError::Crypto)?;
+        let sym_key = unsafe {
+            PK11_ImportSymKey(
+                *slot,
+                CKM_SHA256_HMAC,
+                PK11Origin::PK11_OriginUnwrap,
+                CKA_SIGN,
+                SECItemBorrowed::wrap(key)
+                    .map_err(|_| VaultError::Crypto)?
+                    .as_mut(),
+                ptr::null_mut(),
+            )
+            .into_result()
+            .map_err(|_| VaultError::Crypto)?
+        };
+        let param = SECItemBorrowed::make_empty();
+        let context = unsafe {
+            PK11_CreateContextBySymKey(CKM_SHA256_HMAC, CKA_SIGN, *sym_key, param.as_ref())
+                .into_result()
+                .map_err(|_| VaultError::Crypto)?
+        };
+        unsafe {
+            PK11_DigestOp(*context, data.as_ptr(), len)
+                .into_result()
+                .map_err(|_| VaultError::Crypto)?
+        };
+        let mut digest = vec![0u8; SHA256_LENGTH];
+        let mut digest_len = 0u32;
+        unsafe {
+            PK11_DigestFinal(
+                *context,
+                digest.as_mut_ptr(),
+                &mut digest_len,
+                digest.len() as u32,
+            )
+            .into_result()
+            .map_err(|_| VaultError::Crypto)?
+        };
+        if digest_len as usize != SHA256_LENGTH {
+            return Err(VaultError::Crypto);
+        }
+        Ok(digest)
+    }
+
+    fn aes_cbc_encrypt(
+        &self,
+        key: &[u8],
+        iv: &[u8],
+        data: &[u8],
+    ) -> Result<Vec<u8>, VaultError> {
+        aes_cbc(key, iv, data, true)
+    }
+
+    fn aes_cbc_decrypt(
+        &self,
+        key: &[u8],
+        iv: &[u8],
+        data: &[u8],
+    ) -> Result<Vec<u8>, VaultError> {
+        aes_cbc(key, iv, data, false)
+    }
+}
+
+fn aes_cbc(key: &[u8], iv: &[u8], data: &[u8], encrypt: bool) -> Result<Vec<u8>, VaultError> {
+    nss_rs::init().map_err(|_| VaultError::Crypto)?;
+    if key.len() != KEY_LEN || iv.len() != IV_LEN || data.len() % IV_LEN != 0 {
+        return Err(VaultError::Crypto);
+    }
+    let len = c_uint::try_from(data.len()).map_err(|_| VaultError::Crypto)?;
+    let slot = Slot::internal().map_err(|_| VaultError::Crypto)?;
+    let sym_key = unsafe {
+        PK11_ImportSymKey(
+            *slot,
+            CKM_AES_CBC,
+            PK11Origin::PK11_OriginUnwrap,
+            CKA_ENCRYPT,
+            SECItemBorrowed::wrap(key)
+                .map_err(|_| VaultError::Crypto)?
+                .as_mut(),
+            ptr::null_mut(),
+        )
+        .into_result()
+        .map_err(|_| VaultError::Crypto)?
+    };
+    let mut params = SECItemBorrowed::wrap(iv).map_err(|_| VaultError::Crypto)?;
+    let params_ptr: *mut SECItem = params.as_mut();
+    let mut out_len: c_uint = 0;
+    let mut out = vec![0u8; data.len()];
+    let result = unsafe {
+        if encrypt {
+            PK11_Encrypt(
+                *sym_key,
+                CKM_AES_CBC,
+                params_ptr,
+                out.as_mut_ptr(),
+                &mut out_len,
+                len,
+                data.as_ptr(),
+                len,
+            )
+        } else {
+            PK11_Decrypt(
+                *sym_key,
+                CKM_AES_CBC,
+                params_ptr,
+                out.as_mut_ptr(),
+                &mut out_len,
+                len,
+                data.as_ptr(),
+                len,
+            )
+        }
+    };
+    result.into_result().map_err(|_| VaultError::Crypto)?;
+    if out_len as usize != data.len() {
+        return Err(VaultError::Crypto);
+    }
+    Ok(out)
+}
diff --git a/dom/webauthn/authrs_bridge/src/passkeys_service.rs b/dom/webauthn/authrs_bridge/src/passkeys_service.rs
new file mode 100644
index 0000000000..d40d83c74f
--- /dev/null
+++ b/dom/webauthn/authrs_bridge/src/passkeys_service.rs
@@ -0,0 +1,178 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+//! `nsIAstraPasskeys` — the vault management seam used by Astra Settings.
+//!
+//! This is deliberately separate from the WebAuthn path: the token owns its
+//! own `Vault` instance, so unlocking in Settings never leaves the WebAuthn
+//! authenticator unlocked (and vice versa).
+
+use crate::nss_seal::NssSeal;
+use crate::platform::pref_vault_path;
+use astra_passkeys::{hash_pin, Vault, VaultError};
+use nserror::{
+    nsresult, NS_ERROR_DOM_INVALID_STATE_ERR, NS_ERROR_DOM_NOT_ALLOWED_ERR, NS_ERROR_FAILURE,
+    NS_ERROR_INVALID_ARG, NS_ERROR_NOT_IMPLEMENTED, NS_OK,
+};
+use nsstring::{nsACString, nsCString};
+use serde_json::json;
+use std::sync::{Arc, Mutex};
+use xpcom::xpcom_method;
+
+struct State {
+    path: String,
+    vault: Arc<Vault>,
+}
+
+#[xpcom(implement(nsIAstraPasskeys), atomic)]
+pub struct AstraPasskeysService {
+    state: Mutex<Option<State>>,
+}
+
+fn map_error(error: VaultError) -> nsresult {
+    match error {
+        VaultError::PinPolicy | VaultError::Invalid => NS_ERROR_INVALID_ARG,
+        VaultError::AuthFailed | VaultError::Locked => NS_ERROR_DOM_NOT_ALLOWED_ERR,
+        VaultError::RateLimited { .. }
+        | VaultError::NotInitialized
+        | VaultError::AlreadyInitialized => NS_ERROR_DOM_INVALID_STATE_ERR,
+        VaultError::Unsupported => NS_ERROR_NOT_IMPLEMENTED,
+        VaultError::Crypto | VaultError::Io => NS_ERROR_FAILURE,
+    }
+}
+
+impl AstraPasskeysService {
+    fn vault(&self) -> Result<Arc<Vault>, nsresult> {
+        let path = pref_vault_path().ok_or(NS_ERROR_DOM_INVALID_STATE_ERR)?;
+        let mut guard = self.state.lock().map_err(|_| NS_ERROR_FAILURE)?;
+        if let Some(state) = guard.as_ref() {
+            if state.path == path {
+                return Ok(state.vault.clone());
+            }
+        }
+        let vault = Arc::new(Vault::open(
+            std::path::PathBuf::from(&path),
+            Arc::new(NssSeal),
+        ));
+        *guard = Some(State {
+            path,
+            vault: vault.clone(),
+        });
+        Ok(vault)
+    }
+
+    fn status_json(&self) -> Result<String, nsresult> {
+        let status = self.vault()?.status();
+        serde_json::to_string(&json!({
+            "exists": status.exists,
+            "has_pin": status.has_pin,
+            "unlocked": status.unlocked,
+            "system_unlock": status.system_unlock,
+            "system_auth_available": status.system_auth_available,
+            "credential_count": status.credential_count,
+            "pin_retries_left": status.pin_retries_left,
+            "locked_for_secs": status.locked_for_secs,
+        }))
+        .map_err(|_| NS_ERROR_FAILURE)
+    }
+}
+
+impl AstraPasskeysService {
+    xpcom_method!(get_status_json => GetStatusJson() -> nsACString);
+    fn get_status_json(&self) -> Result<nsCString, nsresult> {
+        Ok(nsCString::from(self.status_json()?))
+    }
+
+    xpcom_method!(create => Create(aPin: *const nsACString, aSystemUnlock: bool));
+    fn create(&self, pin: &nsACString, system_unlock: bool) -> Result<(), nsresult> {
+        let pin = hash_pin(&pin.to_string()).map_err(map_error)?;
+        self.vault()?
+            .create(&pin, system_unlock)
+            .map_err(map_error)
+    }
+
+    xpcom_method!(unlock => Unlock(aPin: *const nsACString));
+    fn unlock(&self, pin: &nsACString) -> Result<(), nsresult> {
+        let pin = hash_pin(&pin.to_string()).map_err(map_error)?;
+        self.vault()?.unlock_with_pin(&pin).map_err(map_error)
+    }
+
+    xpcom_method!(lock => Lock());
+    fn lock(&self) -> Result<(), nsresult> {
+        self.vault()?.lock();
+        Ok(())
+    }
+
+    xpcom_method!(change_pin => ChangePin(aOldPin: *const nsACString, aNewPin: *const nsACString));
+    fn change_pin(&self, old_pin: &nsACString, new_pin: &nsACString) -> Result<(), nsresult> {
+        let old_pin = hash_pin(&old_pin.to_string()).map_err(map_error)?;
+        let new_pin = hash_pin(&new_pin.to_string()).map_err(map_error)?;
+        let vault = self.vault()?;
+        if !vault.is_unlocked() {
+            vault.unlock_with_pin(&old_pin).map_err(map_error)?;
+        }
+        vault.change_pin(&new_pin).map_err(map_error)
+    }
+
+    xpcom_method!(set_system_unlock => SetSystemUnlock(aEnabled: bool));
+    fn set_system_unlock(&self, enabled: bool) -> Result<(), nsresult> {
+        let vault = self.vault()?;
+        if !vault.is_unlocked() {
+            return Err(NS_ERROR_DOM_NOT_ALLOWED_ERR);
+        }
+        vault.set_system_unlock(enabled).map_err(map_error)
+    }
+
+    xpcom_method!(list_json => ListJson() -> nsACString);
+    fn list_json(&self) -> Result<nsCString, nsresult> {
+        use base64::Engine as _;
+        let e = base64::engine::general_purpose::STANDARD;
+        let credentials = self.vault()?.list().map_err(map_error)?;
+        let rows: Vec<_> = credentials
+            .into_iter()
+            .map(|c| {
+                json!({
+                    "id": e.encode(&c.id),
+                    "rp_id": c.rp_id,
+                    "user_name": c.user_name,
+                    "discoverable": c.discoverable,
+                    "created_at": c.created_at,
+                })
+            })
+            .collect();
+        Ok(nsCString::from(
+            serde_json::to_string(&rows).map_err(|_| NS_ERROR_FAILURE)?,
+        ))
+    }
+
+    xpcom_method!(remove_credential => RemoveCredential(aCredentialIdBase64: *const nsACString) -> bool);
+    fn remove_credential(&self, id: &nsACString) -> Result<bool, nsresult> {
+        use base64::Engine as _;
+        let id = base64::engine::general_purpose::STANDARD
+            .decode(id.to_string())
+            .map_err(|_| NS_ERROR_INVALID_ARG)?;
+        self.vault()?.delete(&id).map_err(map_error)
+    }
+
+    xpcom_method!(remove_all_credentials => RemoveAllCredentials());
+    fn remove_all_credentials(&self) -> Result<(), nsresult> {
+        self.vault()?.delete_all().map_err(map_error)
+    }
+
+    xpcom_method!(destroy => Destroy());
+    fn destroy(&self) -> Result<(), nsresult> {
+        self.vault()?.destroy().map_err(map_error)
+    }
+}
+
+#[no_mangle]
+pub extern "C" fn astra_passkeys_constructor(
+    iid: *const xpcom::nsIID,
+    result: *mut *mut xpcom::reexports::libc::c_void,
+) -> nsresult {
+    let service = AstraPasskeysService::allocate(InitAstraPasskeysService {
+        state: Mutex::new(None),
+    });
+    unsafe { service.QueryInterface(iid, result) }
+}
diff --git a/dom/webauthn/authrs_bridge/src/platform.rs b/dom/webauthn/authrs_bridge/src/platform.rs
new file mode 100644
index 0000000000..5b051fa96e
--- /dev/null
+++ b/dom/webauthn/authrs_bridge/src/platform.rs
@@ -0,0 +1,466 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+//! Astra's platform authenticator.
+//!
+//! A CTAP2.1 platform token (`internal` transport) backed by the encrypted
+//! `astra_passkeys` vault. Every operation requires user verification:
+//! `always_uv` is set, the OS verifier (fprintd) is tried first, and the PIN
+//! from `ClientPIN` unlocks the vault when that is unavailable. The vault is
+//! the only credential store; nothing is cached in the token between
+//! transactions.
+
+use astra_passkeys::{NewCredential, PinHash, StoredCredential, Vault, VaultError, AAGUID};
+use authenticator::crypto::{ecdsa_p256_sha256_sign_raw, COSEAlgorithm, COSEKey, SharedSecret};
+use authenticator::ctap2::attestation::{
+    AAGuid, AttestationObject, AttestationStatement, AttestedCredentialData, AuthenticatorData,
+    AuthenticatorDataFlags, Extension,
+};
+use authenticator::ctap2::client_data::ClientDataHash;
+use authenticator::ctap2::commands::client_pin::{ClientPIN, ClientPinResponse, PINSubcommand};
+use authenticator::ctap2::commands::get_assertion::{
+    GetAssertion, GetAssertionResponse, GetAssertionResult,
+};
+use authenticator::ctap2::commands::get_info::{
+    AuthenticatorInfo, AuthenticatorOptions, AuthenticatorVersion,
+};
+use authenticator::ctap2::commands::get_version::{GetVersion, U2FInfo};
+use authenticator::ctap2::commands::make_credentials::{MakeCredentials, MakeCredentialsResult};
+use authenticator::ctap2::commands::reset::Reset;
+use authenticator::ctap2::commands::selection::Selection;
+use authenticator::ctap2::commands::{CommandError, RequestCtap1, RequestCtap2, StatusCode};
+use authenticator::ctap2::preflight::CheckKeyHandle;
+use authenticator::ctap2::server::{
+    AuthenticatorAttachment, CredentialProtectionPolicy, PublicKeyCredentialDescriptor,
+    PublicKeyCredentialUserEntity, Transport,
+};
+use authenticator::errors::HIDError;
+use authenticator::{FidoDevice, FidoDeviceIO, FidoProtocol, VirtualFidoDevice};
+use cstr::cstr;
+use nsstring::nsCString;
+use rand::{thread_rng, RngCore};
+use std::sync::Arc;
+use xpcom::interfaces::nsIPrefBranch;
+
+const SYSTEM_AUTH_TIMEOUT: std::time::Duration = std::time::Duration::from_secs(20);
+const UV_RETRIES: u8 = 3;
+
+/// The vault path the chrome application publishes at startup. Absent or empty
+/// means the platform token is not offered.
+pub(crate) fn pref_vault_path() -> Option<String> {
+    let mut path = nsCString::new();
+    let prefs =
+        xpcom::get_service::<nsIPrefBranch>(cstr!("@mozilla.org/preferences-service;1"))?;
+    unsafe { prefs.GetCharPref(cstr!("astra.passkeys.vault").as_ptr(), &mut *path) }
+        .to_result()
+        .ok()?;
+    let path = path.to_string();
+    if path.is_empty() {
+        None
+    } else {
+        Some(path)
+    }
+}
+
+pub struct PlatformToken {
+    vault: Arc<Vault>,
+    protocol: FidoProtocol,
+    shared_secret: Option<SharedSecret>,
+    authenticator_info: Option<AuthenticatorInfo>,
+    pin_token: Vec<u8>,
+}
+
+fn status_error(code: StatusCode) -> HIDError {
+    HIDError::Command(CommandError::StatusCode(code, None))
+}
+
+fn vault_error(error: VaultError) -> HIDError {
+    match error {
+        VaultError::RateLimited { .. } => status_error(StatusCode::PinAuthBlocked),
+        VaultError::Locked => status_error(StatusCode::PinRequired),
+        VaultError::AuthFailed => status_error(StatusCode::PinInvalid),
+        VaultError::PinPolicy => status_error(StatusCode::PinPolicyViolation),
+        _ => HIDError::DeviceError,
+    }
+}
+
+fn policy_to_u8(policy: CredentialProtectionPolicy) -> u8 {
+    match policy {
+        CredentialProtectionPolicy::UserVerificationOptional => 0x01,
+        CredentialProtectionPolicy::UserVerificationOptionalWithCredentialIDList => 0x02,
+        CredentialProtectionPolicy::UserVerificationRequired => 0x03,
+    }
+}
+
+impl std::fmt::Debug for PlatformToken {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("PlatformToken")
+            .field("protocol", &self.protocol)
+            .finish_non_exhaustive()
+    }
+}
+
+impl PlatformToken {
+    pub fn new(vault: Arc<Vault>) -> Self {
+        let mut pin_token = vec![0u8; 32];
+        thread_rng().fill_bytes(&mut pin_token);
+        Self {
+            vault,
+            protocol: FidoProtocol::CTAP2,
+            shared_secret: None,
+            authenticator_info: None,
+            pin_token,
+        }
+    }
+
+    fn status(&self) -> astra_passkeys::VaultStatus {
+        self.vault.status()
+    }
+
+    fn encrypted_pin_token(&self) -> Result<ClientPinResponse, HIDError> {
+        let secret = self.shared_secret.as_ref().ok_or(HIDError::DeviceError)?;
+        let pin_token = secret.encrypt(&self.pin_token).or(Err(HIDError::DeviceError))?;
+        Ok(ClientPinResponse {
+            pin_token: Some(pin_token),
+            ..Default::default()
+        })
+    }
+
+    fn verified(&self) -> Result<(), HIDError> {
+        if self.vault.is_unlocked() {
+            Ok(())
+        } else {
+            Err(status_error(StatusCode::PinRequired))
+        }
+    }
+}
+
+impl FidoDevice for PlatformToken {
+    fn pre_init(&mut self) -> Result<(), HIDError> {
+        Ok(())
+    }
+
+    fn should_try_ctap2(&self) -> bool {
+        true
+    }
+
+    fn initialized(&self) -> bool {
+        true
+    }
+
+    fn is_u2f(&mut self) -> bool {
+        true
+    }
+
+    fn get_shared_secret(&self) -> Option<&SharedSecret> {
+        self.shared_secret.as_ref()
+    }
+
+    fn set_shared_secret(&mut self, shared_secret: SharedSecret) {
+        self.shared_secret = Some(shared_secret);
+    }
+
+    fn get_authenticator_info(&self) -> Option<&AuthenticatorInfo> {
+        self.authenticator_info.as_ref()
+    }
+
+    fn set_authenticator_info(&mut self, authenticator_info: AuthenticatorInfo) {
+        self.authenticator_info = Some(authenticator_info);
+    }
+
+    fn get_protocol(&self) -> FidoProtocol {
+        self.protocol
+    }
+
+    fn downgrade_to_ctap1(&mut self) {
+        self.protocol = FidoProtocol::CTAP1
+    }
+}
+
+impl FidoDeviceIO for PlatformToken {
+    fn send_msg_cancellable<Out, Req: RequestCtap1<Output = Out> + RequestCtap2<Output = Out>>(
+        &mut self,
+        msg: &Req,
+        keep_alive: &dyn Fn() -> bool,
+    ) -> Result<Out, HIDError> {
+        if !self.initialized() {
+            return Err(HIDError::DeviceNotInitialized);
+        }
+        match self.get_protocol() {
+            FidoProtocol::CTAP1 => self.send_ctap1_cancellable(msg, keep_alive),
+            FidoProtocol::CTAP2 => self.send_cbor_cancellable(msg, keep_alive),
+        }
+    }
+
+    fn send_cbor_cancellable<Req: RequestCtap2>(
+        &mut self,
+        msg: &Req,
+        _keep_alive: &dyn Fn() -> bool,
+    ) -> Result<Req::Output, HIDError> {
+        msg.send_to_virtual_device(self)
+    }
+
+    fn send_ctap1_cancellable<Req: RequestCtap1>(
+        &mut self,
+        msg: &Req,
+        _keep_alive: &dyn Fn() -> bool,
+    ) -> Result<Req::Output, HIDError> {
+        msg.send_to_virtual_device(self)
+    }
+}
+
+impl VirtualFidoDevice for PlatformToken {
+    fn check_key_handle(&self, req: &CheckKeyHandle) -> Result<(), HIDError> {
+        let credentials = self
+            .vault
+            .credentials_for_rp(&req.rp.id, &[], false)
+            .map_err(vault_error)?;
+        if credentials.iter().any(|c| c.id == req.key_handle) {
+            Ok(())
+        } else {
+            Err(HIDError::DeviceError)
+        }
+    }
+
+    fn client_pin(&self, req: &ClientPIN) -> Result<ClientPinResponse, HIDError> {
+        match req.subcommand {
+            PINSubcommand::GetKeyAgreement => {
+                let (_private, public) = COSEKey::generate(COSEAlgorithm::ECDH_ES_HKDF256)
+                    .map_err(|_| HIDError::DeviceError)?;
+                Ok(ClientPinResponse {
+                    key_agreement: Some(public),
+                    ..Default::default()
+                })
+            }
+            PINSubcommand::GetPinRetries => Ok(ClientPinResponse {
+                pin_retries: Some(self.status().pin_retries_left.min(8) as u8),
+                ..Default::default()
+            }),
+            PINSubcommand::GetUvRetries => Ok(ClientPinResponse {
+                uv_retries: Some(UV_RETRIES),
+                ..Default::default()
+            }),
+            PINSubcommand::GetPinUvAuthTokenUsingUvWithPermissions => {
+                if !self.status().system_unlock {
+                    return Err(status_error(StatusCode::UvBlocked));
+                }
+                if astra_passkeys::verify_system_auth(SYSTEM_AUTH_TIMEOUT)
+                    && self.vault.unlock_with_device().is_ok()
+                {
+                    self.encrypted_pin_token()
+                } else {
+                    Err(status_error(StatusCode::UvBlocked))
+                }
+            }
+            PINSubcommand::GetPinUvAuthTokenUsingPinWithPermissions
+            | PINSubcommand::GetPINToken => {
+                let Some(encrypted) = req.pin_hash_enc.as_ref() else {
+                    return Err(status_error(StatusCode::PinRequired));
+                };
+                let secret = self.shared_secret.as_ref().ok_or(HIDError::DeviceError)?;
+                let plain = secret.decrypt(encrypted).or(Err(HIDError::DeviceError))?;
+                let pin = PinHash::from_bytes(&plain).or(Err(HIDError::DeviceError))?;
+                match self.vault.unlock_with_pin(&pin) {
+                    Ok(()) => self.encrypted_pin_token(),
+                    Err(VaultError::RateLimited { .. }) => {
+                        Err(status_error(StatusCode::PinAuthBlocked))
+                    }
+                    Err(VaultError::AuthFailed) => Err(status_error(StatusCode::PinInvalid)),
+                    Err(e) => Err(vault_error(e)),
+                }
+            }
+            _ => Err(HIDError::UnsupportedCommand),
+        }
+    }
+
+    fn get_info(&self) -> Result<AuthenticatorInfo, HIDError> {
+        let status = self.status();
+        Ok(AuthenticatorInfo {
+            versions: vec![AuthenticatorVersion::FIDO_2_1],
+            options: AuthenticatorOptions {
+                platform_device: true,
+                resident_key: true,
+                client_pin: Some(status.has_pin),
+                pin_uv_auth_token: Some(true),
+                user_verification: Some(true),
+                make_cred_uv_not_rqd: Some(false),
+                always_uv: Some(true),
+                ..Default::default()
+            },
+            ..Default::default()
+        })
+    }
+
+    fn get_version(&self, _req: &GetVersion) -> Result<U2FInfo, HIDError> {
+        Err(HIDError::UnsupportedCommand)
+    }
+
+    fn make_credentials(&self, req: &MakeCredentials) -> Result<MakeCredentialsResult, HIDError> {
+        if !req
+            .pub_cred_params
+            .iter()
+            .any(|p| p.alg == COSEAlgorithm::ES256)
+        {
+            return Err(status_error(StatusCode::UnsupportedAlgorithm));
+        }
+        if req.pin_uv_auth_param.is_none() {
+            return Err(status_error(StatusCode::PinRequired));
+        }
+        self.verified()?;
+
+        let user = req
+            .user
+            .as_ref()
+            .ok_or_else(|| status_error(StatusCode::InvalidParameter))?;
+
+        let excluded: Vec<Vec<u8>> = req.exclude_list.iter().map(|d| d.id.clone()).collect();
+        if !excluded.is_empty() {
+            let existing = self
+                .vault
+                .credentials_for_rp(&req.rp.id, &excluded, false)
+                .map_err(vault_error)?;
+            if !existing.is_empty() {
+                return Err(status_error(StatusCode::CredentialExcluded));
+            }
+        }
+
+        let (private_key, public_key) =
+            COSEKey::generate(COSEAlgorithm::ES256).map_err(|_| HIDError::DeviceError)?;
+        let public_key_bytes =
+            serde_cbor_2::to_vec(&public_key).map_err(|_| HIDError::DeviceError)?;
+        let mut id = [0u8; 32];
+        thread_rng().fill_bytes(&mut id);
+
+        let cred_protect = req
+            .extensions
+            .cred_protect
+            .unwrap_or(CredentialProtectionPolicy::UserVerificationRequired);
+        self.vault
+            .add_credential(NewCredential {
+                id: id.to_vec(),
+                rp_id: req.rp.id.clone(),
+                user_handle: user.id.clone(),
+                user_name: user.name.clone(),
+                private_key,
+                public_key: public_key_bytes,
+                discoverable: req.options.resident_key.unwrap_or(true),
+                cred_protect: policy_to_u8(cred_protect),
+            })
+            .map_err(vault_error)?;
+
+        let mut extensions = Extension::default();
+        extensions.cred_protect = req.extensions.cred_protect;
+        if req.extensions.min_pin_length == Some(true) {
+            extensions.min_pin_length = Some(u64::from(astra_passkeys::MIN_PIN_LENGTH_HINT));
+        }
+        let mut flags =
+            AuthenticatorDataFlags::USER_PRESENT | AuthenticatorDataFlags::USER_VERIFIED;
+        if extensions.has_some() {
+            flags |= AuthenticatorDataFlags::EXTENSION_DATA;
+        }
+        flags |= AuthenticatorDataFlags::ATTESTED;
+
+        let auth_data = AuthenticatorData {
+            rp_id_hash: req.rp.hash(),
+            flags,
+            counter: 0,
+            credential_data: Some(AttestedCredentialData {
+                aaguid: AAGuid(AAGUID),
+                credential_id: id.to_vec(),
+                credential_public_key: public_key,
+            }),
+            extensions,
+        };
+
+        Ok(MakeCredentialsResult {
+            attachment: AuthenticatorAttachment::Platform,
+            att_obj: AttestationObject {
+                att_stmt: AttestationStatement::None,
+                auth_data,
+            },
+            extensions: Default::default(),
+            ep_attestation: None,
+            large_blob_key: None,
+            unsigned_extension_outputs: None,
+        })
+    }
+
+    fn get_assertion(&self, req: &GetAssertion) -> Result<Vec<GetAssertionResult>, HIDError> {
+        if req.pin_uv_auth_param.is_none() {
+            return Err(status_error(StatusCode::PinRequired));
+        }
+        self.verified()?;
+
+        let allow: Vec<Vec<u8>> = req.allow_list.iter().map(|d| d.id.clone()).collect();
+        let discoverable_only = allow.is_empty();
+        let credentials = self
+            .vault
+            .credentials_for_rp(&req.rp.id, &allow, discoverable_only)
+            .map_err(vault_error)?;
+
+        let eligible: Vec<&StoredCredential> = credentials
+            .iter()
+            .filter(|c| {
+                c.cred_protect != 0x03
+                    || self.vault.is_unlocked()
+            })
+            .collect();
+        if eligible.is_empty() {
+            return Err(status_error(StatusCode::NoCredentials));
+        }
+
+        let flags = AuthenticatorDataFlags::USER_PRESENT | AuthenticatorDataFlags::USER_VERIFIED;
+        let mut assertions = Vec::with_capacity(eligible.len());
+        for credential in eligible {
+            let auth_data = AuthenticatorData {
+                rp_id_hash: req.rp.hash(),
+                flags,
+                counter: 0,
+                credential_data: None,
+                extensions: Extension::default(),
+            };
+            let mut data = auth_data.to_vec();
+            data.extend_from_slice(req.client_data_hash.as_ref());
+            let signature = ecdsa_p256_sha256_sign_raw(&credential.private_key, &data)
+                .map_err(|_| HIDError::DeviceError)?;
+            let assertion = GetAssertionResponse {
+                credentials: Some(PublicKeyCredentialDescriptor {
+                    id: credential.id.clone(),
+                    transports: vec![Transport::Internal],
+                }),
+                auth_data,
+                signature,
+                user: Some(PublicKeyCredentialUserEntity {
+                    id: credential.user_handle.clone(),
+                    name: credential.user_name.clone(),
+                    display_name: None,
+                }),
+                number_of_credentials: Some(1),
+                user_selected: None,
+                large_blob_key: None,
+                unsigned_extension_outputs: None,
+                ep_attestation: None,
+                att_stmt: None,
+            };
+            assertions.push(GetAssertionResult {
+                assertion: assertion.into(),
+                attachment: AuthenticatorAttachment::Platform,
+                extensions: Default::default(),
+                user_selected: None,
+                large_blob_key: None,
+                large_blob_array: None,
+            });
+        }
+        Ok(assertions)
+    }
+
+    fn reset(&self, _req: &Reset) -> Result<(), HIDError> {
+        self.verified()?;
+        self.vault.delete_all().map_err(vault_error)
+    }
+
+    fn selection(&self, _req: &Selection) -> Result<(), HIDError> {
+        Err(HIDError::UnsupportedCommand)
+    }
+}
